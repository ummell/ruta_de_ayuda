# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# USGS (datos públicos)
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed

# EMAIL (Resend) - envío del edit_token para marcar "encontrada"
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="RutaDeAyuda <no-reply@rutadeayuda.example>"

# OTP (SMS) - Supabase o Twilio
OTP_PROVIDER=supabase
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# RE-CAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# DOMINIO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RutaDeAyuda"

# RATE LIMITING
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# UPLOAD
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
